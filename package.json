{
	"name": "tempra",
	"version": "0.1.3",
	"description": "tempra.ventilii.dev: cognitive-load games for athletes during recovery breaks, with coach-controlled remote parameters. Version is managed by release-please.",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:i18n": "node scripts/check-locale-catalogs.mjs",
		"lint": "prettier --check . && eslint . --max-warnings 0 && npm run check:i18n",
		"format": "prettier --write . && eslint . --fix",
		"quality": "npm run format && npm run lint",
		"test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --import ./scripts/test/register.mjs --test src/tests/*.test.ts",
		"e2e": "playwright test",
		"e2e:install": "playwright install --with-deps chromium",
		"cap:sync": "npm run build && cap sync",
		"cap:android": "npm run cap:sync && cap open android",
		"cap:ios": "npm run cap:sync && cap open ios"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.19.0",
		"eslint": "^9.39.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^16.4.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.2.1"
	},
	"dependencies": {
		"@capacitor/android": "^8.5.3",
		"@capacitor/app": "^8.1.2",
		"@capacitor/cli": "^8.5.3",
		"@capacitor/core": "^8.5.3",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/ios": "^8.5.3",
		"@capacitor/splash-screen": "^8.0.2",
		"@capacitor/status-bar": "^8.0.4",
		"@supabase/supabase-js": "^2.58.0"
	}
}
